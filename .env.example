PORT=3000
NODE_ENV=production
# Secreto para firmar los JWT (npm run setup genera uno aleatorio en .env)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-bytes
# Claves VAPID para web-push (npm run setup las genera; o: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu-correo@ejemplo.com
ALLOWED_NEWS_HOSTS=uptc.edu.co,www.uptc.edu.co
# Opcional: intentos fallidos de login por IP cada 15 min
LOGIN_RATE_LIMIT=10
